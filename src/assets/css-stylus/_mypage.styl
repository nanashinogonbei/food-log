/*
 *
 * mypage style
 * language: stylus
 *
 */
@import "./common/_mixin"




#MYPAGE

	#l-content
		margin-top: 15px

	.heading .count
		font-size: 1.6rem
		font-weight: 400

	.product-content
		margin: 60px 0

	.list-request
		display: flex
		flex-wrap: wrap
		gap: 20px
		.item
			display: flex
			position: relative
			align-items: center
			gap: 10px
			width: calc( (100% - 40px) / 3 )
			padding: 15px
			
			&.-approved
				border: 1px solid #DBDBDB
			&.-pending
				background-color: #F0F0F0
			
			img
				max-width: 80px
			
			.cluster-txt
				line-height: 1.4
				.name
					margin-bottom: 6px
					line-height: 1.4
					font-weight: bold
				.distributor
					font-size: 1.4rem
				.manufacturing
					margin-top: 6px
					font-size: 1.4rem
				.label
					display: block
					font-size: 1.2rem
				.status
					position: absolute
					top: 0
					right: 0
					padding: 3px 7px 4px
					font-size: 1.2rem
					font-weight: bold
					background-color: #DBDBDB



	.product-listValuation
		display: flex
		flex-wrap: wrap
		gap: 20px
		.item
			position: relative
			width: calc( (100% - 40px) / 3 )
			padding: 15px 15px 40px
			border: 1px solid border-c
			.elem-img
				height: 150px
				margin: 0 auto 15px
				text-align: center
				img
					object-fit: contain
					max-height: 100%
			.elem-name
				margin-bottom: 15px
				line-height: 1.4
				font-weight: bold
			.elem-date
				font-size: 1.4rem
			.elem-price
				margin-top: 5px
				font-size: 1.4rem
			.elem-store
				margin-top: 5px
				font-size: 1.4rem
			.elem-score
				margin-top: 15px
				font-size: 2.0rem
				font-weight: bold
			.elem-comment
				margin-top: 3px
				line-height: 1.4
			.elem-actions
				display: grid
				grid-template-columns: repeat(2, 1fr)
				position: absolute
				bottom: 0
				left: 0
				width: 100%

	.stack-formRow
		.elem-parts
			position: relative
			.category-cascade
				select + select
					margin-left: 10px

	.stack-photoPost
		display: flex
		gap: 10px
	
	.stack-dropzone
		display: flex
		justify-content: center
		align-items: center
		flex-grow: 1
		gap: 15px
		min-height: 120px
		padding: 15px
		border: 2px dashed #ccc
		border-radius: 8px
		line-height: 1.4
		color: #999
		//background: #F5F5F5 url(/assets/img/icon-img.svg) no-repeat center center / 60px auto
		background-color: #F5F5F5
		cursor: pointer
		&:hover,
		&:focus-visible
			border-color: #666

		.elem-input
			display: none

	.photo-dropzone__error
		margin: 0.5rem 0 0
		color: #d93025
		font-size: 0.85rem

	.cluster-listThumbs
		display: flex
		flex-wrap: wrap
		justify-content: center
		align-items: center
		gap: 10px
		padding: 15px
		border: 2px dashed #8FCC8F
		border-radius: 8px
		background-color: #F0FAF0

		.item
			display: flex
			justify-content: center
			align-items: center
			position: relative
			width: 100px
			height: 100px
			background-color: #fff
			img
				max-height: 100%
				object-fit: cover

	.stack-selectedProduct
		display: flex
		gap: 10px
		align-items: center
		margin-top: 10px
		padding: 15px
		background-color: #E6F0FA
		img
			width: 40px
		&:has(.elem-alert)
			background-color: #FAF5DC
		.elem-alert
			color: #B29500
			font-weight: bold

	.list-autocomplete
		.item:hover
			background-color: #FAF6E1



