/*
 *
 * mypage style
 * language: stylus
 *
 */
@import "./common/_mixin"




#MYPAGE

	#l-content
		margin-top: 15px

	.heading .count
		font-size: 1.6rem
		font-weight: 400

	.product-content
		margin: 60px 0

	.list-request
		display: flex
		flex-wrap: wrap
		gap: 20px
		.item
			display: flex
			position: relative
			align-items: center
			gap: 10px
			width: calc( (100% - 40px) / 3 )
			padding: 15px
			
			&.-approved
				border: 1px solid #DBDBDB
			&.-pending
				background-color: #E6FAE6
				.status
					color: #fff
					background-color: #3D993D !important
			&.-private,
			&.-rejected
				background-color: #F0F0F0
			
			img
				width: 80px
				height: 80px
				object-fit: contain
			
			.cluster-txt
				line-height: 1.4
				.name
					margin-bottom: 6px
					line-height: 1.4
					font-weight: bold
				.distributor
					font-size: 1.4rem
				.manufacturing
					margin-top: 6px
					font-size: 1.4rem
				.label
					display: block
					font-size: 1.2rem
				.status
					position: absolute
					top: 0
					right: 0
					padding: 3px 7px 4px
					font-size: 1.2rem
					font-weight: bold
					background-color: #DBDBDB

	.stack-formRow
		.elem-parts
			position: relative
			.category-cascade
				select + select
					margin-left: 10px

	photoPickerStyle()

	.cluster-listThumbs
		display: flex
		flex-wrap: wrap
		justify-content: center
		align-items: center
		gap: 10px
		padding: 15px
		border: 2px dashed #8FCC8F
		border-radius: 8px
		background-color: #F0FAF0

		.item
			display: flex
			justify-content: center
			align-items: center
			position: relative
			width: 100px
			height: 100px
			background-color: #fff
			img
				max-height: 100%
				object-fit: cover

	.stack-selectedProduct
		display: flex
		gap: 10px
		align-items: center
		margin-top: 10px
		padding: 15px
		background-color: #E6F0FA
		&:has(.elem-alert)
			background-color: #FAF5DC
		.elem-img
			line-height: 0
			img
				width: 60px
				height: 60px
				object-fit: contain
		.elem-alert
			color: #B29500
			font-weight: bold

	.list-autocomplete
		.item:hover
			background-color: #FAF6E1

	.stack-button.-logout
		margin-top: 50px



