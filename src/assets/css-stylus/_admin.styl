/*
 *
 * admin style
 * language: stylus
 *
 */
@import "./common/_mixin"




#ADMIN

	#l-content
		margin-top: 15px

	.heading .count
		font-size: 1.6rem
		font-weight: 400

	.product-content
		margin: 60px 0
		
	.product-listApplication
		> .item
			border: 1px solid border-c
			+ .item
				margin-top: 60px
			
			.inner
				padding: 20px
			.elem-name
				margin-bottom: 12px
				font-size: 2.0rem
				font-weight: bold
			.elem-status
				font-size: 1.2rem
			.elem-metaUser,
			.elem-metaCompany
				line-height: 1.6
				font-size: 1.4rem
			.stack-photos
				display: flex
				gap: 20px
				margin-top: 30px
				> .item
					position: relative
					width: 120px

			.product-form
				padding: 30px 20px 0


	.stack-formRow
		.elem-parts
			position: relative
			.category-cascade
				select + select
					margin-left: 10px



