/*
 *
 * top page style
 * language: stylus
 *
 */
@import "./common/_mixin"



#TOP

	.product-fv
		display: flex
		position: relative
		justify-content: center
		align-items: center
		height: 300px
		background: #FF8233
		
		.product-search
			position: relative
			width: 60%
			.elem-input
				width: 100%
				height: 60px
				padding: 0 1.5em
				border: none
				border-radius: 100px
				background-color: #fff
				transition: box-shadow ease-in-out 0.2s
				&:focus
					box-shadow: 0px 0px 25px 0 rgba(0, 0, 0, 0.25)
				&:focus-visible
					outline: none

		.list-bg
			display: flex
			position: absolute
			top: 0
			left: 0
			width: 100%
			height: 300px
			opacity: 0.15
			.item
				width: 25%
			img
				width: 100%
				height: 100%
				object-fit: cover
				

	.product-content
		display: flex
		gap: 5%
		max-width: 1000px
		margin: 60px auto 0
		
		.product-category
			width: 60%
		
			.stack-category
				+ .stack-category
					margin-top: 60px
				.heading
					margin-bottom: 20px
					font-size: 2.2rem
					font-weight: bold

		.product-subContent
			width: 35%


	.product-pickup
		padding: 15px
		background-color: #F5F5F5
		
		&.-recent
			margin-top: 30px
		
		.heading
			margin-bottom: 15px
			text-align: center
			font-size: 1.8rem
		
		.inner
			background-color: #fff
			
		.stack-list
			.item + .item
				margin-top: 15px



