/*
 *
 * top page style
 * language: stylus
 *
 */
@import "./common/_mixin"



#TOP

	.product-fv
		display: flex
		position: relative
		justify-content: center
		align-items: center
		height: 300px
		background: #FF8233
		
		.product-search
			position: relative
			width: 60%
			.elem-input
				width: 100%
				height: 60px
				padding: 0 1.5em

		.list-bg
			display: flex
			position: absolute
			top: 0
			left: 0
			width: 100%
			height: 300px
			opacity: 0.15
			.item
				width: 25%
			img
				width: 100%
				height: 100%
				object-fit: cover
				

	.product-content
		display: flex
		gap: 5%
		max-width: 1000px
		margin: 60px auto 0
		
		.product-category
			width: 60%
		
			.stack-category
				+ .stack-category
					margin-top: 60px
				.heading
					margin-bottom: 20px
					font-size: 2.2rem
					font-weight: bold

		.product-subContent
			width: 35%

	.product-ranking
		padding: 15px
		background-color: #F5F5F5
		
		.inner
			background-color: #fff
		
		.heading
			margin-bottom: 15px
			text-align: center
			font-size: 1.8rem
			font-weight: bold
		
		.stack-tabs
			display: flex
			gap: 1px
			border-bottom: 2px solid #FF8233
			.item
				width: calc( 100% - 4px / 3 )
				padding: 8px 0 10px
				text-align: center
				font-size: 1.4rem
				background-color: #EBEBEB
				&.-active
					background-color: #DBDBDB
					
		.elem-functionTxt
			padding: 20px
			line-height: 1.4
			
		.list-ranking
			padding: 20px 15px
			.item
				.inner
					display: flex
					gap: 10px
					align-items: center
					position: relative
				.elem-img
					max-width: 120px
				.cluster-txt
					.elem-ranking
						display: block
						margin-bottom: 10px
					.elem-name
						display: block
						margin-bottom: 10px
					.elem-count
						display: block
						font-size: 1.4rem


