/*
 *
 * elements style
 * language: stylus
 *
 */
@import "./_mixin"



/********************
* headline
********************/

.heading
	&.-typeA
		margin-bottom: 30px
		font-size: 3.6rem
		font-weight: bold
	&.-typeB
		padding: 12px 15px 15px
		margin-bottom: 30px
		font-size: 2.2rem
		font-weight: bold
		background-color: #f5f5f5
	&.-typeC
		margin-bottom: 15px
		font-size: 2.6rem
		font-weight: bold
	&.-typeD
		margin-bottom: 10px
		font-size: 1.8rem
		font-weight: bold



/********************
* list
********************/

.list-autocomplete
	overflow: hidden
	position: absolute
	z-index: 10
	top: 68px
	width: 100%
	border-radius: 10px
	box-shadow: 0px 0px 20px 0 rgba(0, 0, 0, 0.2)
	background-color: #fff
	.item
		padding: 10px
		cursor: pointer
		&.-active
			background-color: #FAF6E1
		img
			width: 40px
			margin-right: 10px
			vertical-align: middle
	
.stack-linkLink
	&.-typeA
		display: flex
		flex-wrap: wrap
		gap: 12px 10px
		padding-bottom: 2px
		.item
			a
				display: block
				padding: 20px 20px 20px 40px
				border: 1px solid border-c
				border-radius: 4px
				box-shadow: 0 2px 0 border-c
				background: url(/assets/img/icon-arrow-typeA.svg) no-repeat 20px 24px / 14px auto
			a:hover
				border-color: border-hc
				box-shadow: 0 2px 0 border-hc
				background-color: bg-hc
	


/********************
* table
********************/





/********************
* box
********************/

.stack-selectUI
	display: flex
	gap: 20px
	label
		padding: 15px 20px
		border: 1px solid #ccc
		border-radius: 8px
	label:has(input[type="radio"]:checked)
		background-color: #E6F0FA


.stack-error
	padding: 13px 20px 15px 42px
	color: #CC0000
	font-weight: bold
	background: #FAEBED url(/assets/img/icon-attention.svg) no-repeat 20px 15px / 18px auto

.stack-tabs
	display: flex
	gap: 1px
	border-bottom: 2px solid main-c
	.item
		width: calc( 100% - 4px / 3 )
		padding: 8px 0 10px
		text-align: center
		font-size: 1.4rem
		background-color: #EBEBEB
		cursor: pointer
		&.-active
			font-weight: bold
			background-color: #DBDBDB


.product-pickup
	
	.heading
		font-weight: bold
				
	.elem-functionTxt
		padding: 20px
		line-height: 1.4

	.stack-list
		padding: 20px 15px
		.item
			.inner
				display: flex
				gap: 15px
				align-items: center
			.elem-img
				flex-shrink: 0
				width: 80px
				height: 80px
				object-fit: cover
			.cluster-txt
				min-width: 0
				span
					display: block
				.elem-name
					font-weight: bold
					line-height: 1.4
				.elem-score
					margin-top: 4px
					font-size: 1.3rem
					font-weight: bold
					&.-poor
						color: #777
					&.-like
						color: #E67300
					&.-love
						color: #D9363E
				.elem-comment
					margin-top: 4px
					font-size: 1.3rem
					line-height: 1.5
					color: #555
				.elem-count,
				.elem-date
					margin-top: 4px
					font-size: 1.2rem
					color: #888

.stack-button
	padding: 20px
	text-align: center
	background-color: #f0f0f0



/********************
* btn
********************/

.elem-button
	position: relative
	cursor: pointer
	+ .elem-button
		margin-left: 20px
	&.-typeA
		top: 0
		min-width: 250px
		padding: 18px 30px 20px
		border: 1px solid #ccc
		box-shadow: 0 2px 0 #ccc
		border-radius: 6px
		background: linear-gradient(0deg, #F0F0F0 0%, #fff 100%)
		&:hover,
		&.-active
			top: 1px
			border-color: border-hc
			box-shadow: 0 1px 0 border-hc
			color: #FF8233
			background: bg-hc

.button-remove
	position: absolute
	top: -8px
	right: -8px
	width: 24px
	height: 24px
	padding: 0
	border: none
	border-radius: 50%
	color: #fff
	font-size: 1rem
	background-color: #666
	cursor: pointer
	&:hover
		background-color: #aaa



/********************
* txt
********************/

.elem-nomalTxt
	line-height: 1.6

.elem-link
	&:link, &:visited
		color: #297ACC
		text-decoration: underline
	&:hover
		color: main-c
		text-decoration: none	
		
	&.-typeA
		display: block
		padding: 0 0 0 20px
		background: url(/assets/img/icon-arrow-typeA.svg) no-repeat 0 6px / 14px auto
	&.-typeB
		@extend .elem-link.-typeA
		background-position: 0 4px

.elem-notes
	&.-typeA
		margin-top: 8px
		color: #808080
		font-size: 1.4rem




/********************
* form
********************/

input[type="text"],
textarea
	width: 100%
	padding: 15px
	border: 1px solid #ccc
	border-radius: 6px
	&::placeholder
		color: #999
	&:focus, &:focus-visible
		outline: none
		box-shadow: 0px 0px 20px 0 rgba(0, 0, 0, 0.1)
		background-color: #E6F0FA

input[type="radio"]
	width: 24px
	height: 24px
	margin-right: 6px
	vertical-align: -6px

select
	padding: 10px
	border: 1px solid #ccc
	border-radius: 6px	


.product-form

	.stack-formRow
		margin-bottom: 30px

	.elem-label
		margin-bottom: 10px
		font-weight: bold

	.icon-required
		width: 40px
		margin-right: 8px
		vertical-align: -3px

	.input-10em
		width: 10em
		margin-right: 10px




