/*
 *
 * layouts style
 * language: stylus
 *
 */
@import "./_mixin"



#root
	position: relative
	overflow: hidden
	padding-top: 60px

#l-header
	display: flex
	justify-content: space-between
	position: fixed
	z-index: 1001
	top: 0
	width: 100%
	padding: 20px
	background-color: #fff


#l-header.-jsShrink
	position: fixed

#menu
	display: none

#l-footer

#layer
	display: none
	position: fixed
	top: 0
	left: 0
	width: 100%
	height: 100dvh
	background-color: rgba(0,0,0,0.8)





/*
 *	width: ~1023px
 */

@media (max-width: 1023px)

	#l-header

	#l-header.-jsShrink

	#menu
		display: block
		position: absolute
		top: 50%
		right: 10px
		width: 30px
		height: 14px
		transform: translateY(-50%) 
		.line
			display: block
			position: absolute
			right: 0
			width: 100%
			height: 2px
			background-color: #ccc
			transition: all 0.3s ease-out
			&:nth-child(1)
				top: 0
			&:nth-child(2)
				top: 6px
				width: 80%
			&:nth-child(3)
				top: 12px
				width: 60%
	#menu.-open
		.line
			&:nth-child(1)
				top: 6px
				width: 80%
				transform: rotate(45deg)
			&:nth-child(2)
				opacity: 0
			&:nth-child(3)
				top: 6px
				width: 80%
				transform: rotate(-45deg)





