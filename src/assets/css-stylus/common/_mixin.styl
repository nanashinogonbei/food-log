/*
 *
 * mixin style
 * language: stylus
 *
 */

main-c = #ff8233
border-c = #e0e0e0
border-hc = #F0DACC
bg-hc = #FFF3EB



buttonStyle()
	button
		position: relative
		top: 0
		padding-bottom: 3px
		color: #fff
		font-weight: bold
		border: none
		border-radius: 4px
		cursor: pointer
		&:hover
			top: 2px
		&::before
			display: inline-block
			content: ''
			width: 16px
			height: 16px
			margin-right: 6px
	.button-edit
		border-bottom: 3px solid #cc4f00
		background-color: #ff8233
		&::before
			background: url(/assets/img/icon-edit.svg) no-repeat center center / auto 16px
		&:hover
			border-bottom: 1px solid #cc4f00
			background-color: #e5752e
	.button-delete
		border-bottom: 3px solid #555
		background-color: #999
		&::before
			background: url(/assets/img/icon-delete.svg) no-repeat center center / auto 16px
		&:hover
			border-bottom: 1px solid #555
			background-color: #888

cfix()
	zoom: 1
	&:after
		display: block
		clear: both
		height: 0
		visibility: hidden
		line-height: 0
		content: "."

size(_size)
	round(_size/1399*100, 3)
