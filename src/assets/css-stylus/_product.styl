/*
 *
 * product style
 * language: stylus
 *
 */
@import "./common/_mixin"



#PRODUCT

	.product-info
		display: flex
		gap: 4%
		
		.cluster-img
			width: 35%
			
			.stack-imgMain
				display: flex
				flex-direction: column
				align-items: center
				position: relative
				img
					width: 100%
					height: 300px
					object-fit: contain
				figcaption
					position: absolute
					bottom: 0
					left: 0
					width: 100%
					padding: 4px 5px 5px
					text-align: center
					color: #fff
					font-size: 1.0rem
					background-color: rgba(0,0,0,0.5)
					.elem-link
						color: #fff

			.stack-thumbTrack
				display: flex
				flex-grow: 1
				gap: 5px
				margin-top: 15px
				overflow-x: auto
				scroll-snap-type: x mandatory
				scrollbar-width: none
				&::-webkit-scrollbar
					display: none
				.item
					flex: 0 0 calc( ( 100% - 15px ) / 4 )
					scroll-snap-align: start
					figure
						position: relative
						text-align: center
						&.-active
							opacity: 0.5
					a
						display: block
						width: 100%
						cursor: pointer
					img
						width: 100%
						height: 80px
						object-fit: contain
					figcaption
						position: absolute
						bottom: 0
						left: 0
						width: 100%
						padding: 2px 3px 3px
						color: #fff
						font-size: 0.8rem
						background-color: rgba(0,0,0,0.5)

			.stack-buttons
				display: flex
				justify-content: space-between
				align-items: center
				gap: 15px
				margin-top: 15px
				
				.stack-photoRequest
					font-size: 1.4rem
					&.-login
						font-size: 1.2rem
					.elem-link
						padding-left: 25px
						background: url(/assets/img/icon-upload.svg) no-repeat 0 4px / 20px auto
				
				.stack-carouselButton
					display: flex
					gap: 5px
					.button-prev,
					.button-next
						flex-shrink: 0
						width: 24px
						height: 24px
						border: none
						border-radius: 50%
						color: #fff
						font-size: 0.8rem
						background-color: #000
						cursor: pointer
						&:hover:not(:disabled)
							background-color: main-c
						&:disabled
							opacity: 0.2
							cursor: not-allowed

		.cluster-txt
			width: 61%
			
			.stack-catgory
				margin-bottom: 30px
				font-size: 1.4rem
				.elem-category + .elem-category
					margin-top: 6px

			.stack-price
				margin-bottom: 30px
					
			.stack-company
				display: grid
				grid-template-columns: repeat(2, 1fr)
				gap: 5%

			
	// 商品画像の申請画面
	.stack-photoRequestModal
		display: flex
		justify-content: center
		align-items: center
		position: fixed
		z-index: 1900
		top: 0
		left: 0
		width: 100%
		height: 100dvh
		padding: 20px
		background-color: rgba(0,0,0,0.6)
		.inner
			overflow-y: auto
			width: 100%
			max-width: 760px
			max-height: 100%
			padding: 25px
			border-radius: 8px
			text-align: left
			background-color: #fff
		.elem-title
			margin-bottom: 10px
			font-size: 2rem
			font-weight: bold
		.elem-notes
			margin: 8px 0
			line-height: 1.5
		.stack-success
			padding: 20px 0
			color: #2e7d32
		.stack-modalActions
			display: flex
			flex-wrap: wrap
			justify-content: center
			gap: 10px
			margin-top: 20px
			.elem-button
				min-width: 0
				margin-left: 0
				padding: 12px 18px 14px
				font-size: 1.4rem
				&:disabled
					opacity: 0.5
		photoPickerStyle()

	.stack-valuation
		margin-top: 30px
		padding: 13px 0 15px
		text-align: center
		background-color: #f5f5f5
	
	
	.product-valuation
		margin-top: 60px
	
		.stack-tabs
			.item
				padding: 15px
				font-size: 1.6rem

		.elem-noneTxt
			padding: 50px
			text-align: center

		.stack-listValuation
			.item
				display: flex
				align-items: center
				gap: 15px
				margin-top: 15px
				padding: 20px
				border: 1px solid border-c
				
				.cluster-content
					width: calc( 100% - 150px )
					.elem-user
						margin-bottom: 18px
						font-size: 1.6rem
					.elem-score
						margin-bottom: 4px
						font-size: 2.0rem
						font-weight: bold
					.elem-comment
						margin-bottom: 10px
						line-height: 1.6
					.stack-purchaseInfo
						color: #808080
						font-size: 1.4rem
						p+p
							margin-top: 5px
						
				.cluster-action
					.elem-actions
						display: flex
						gap: 10px
						buttonStyle()
						button
							width: 100px
							height: 50px




